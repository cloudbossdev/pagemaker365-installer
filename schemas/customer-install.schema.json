{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagemaker365.com/schemas/customer-install.schema.json",
  "title": "PageMaker365 Customer Install Package",
  "type": "object",
  "additionalProperties": true,
  "required": ["contractVersion", "customer", "azure", "sharePoint", "app", "entra", "runtimeArtifacts", "controlPlane", "secrets", "features"],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "0.4",
      "description": "Installer package contract version with protected runtime secret metadata and customer runtime settings."
    },
    "customer": {
      "type": "object",
      "required": ["accountKey", "tenantName", "tenantId", "primaryContact"],
      "properties": {
        "customerId": { "type": "string" },
        "accountKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]+$"
        },
        "installationId": { "type": "string" },
        "tenantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]+$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "not": { "const": "00000000-0000-0000-0000-000000000000" }
        },
        "primaryContact": { "type": "string", "minLength": 1 }
      }
    },
    "azure": {
      "type": "object",
      "required": ["subscriptionId", "location", "resourceGroupName", "environment"],
      "properties": {
        "tenantId": { "type": "string" },
        "subscriptionId": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "resourceGroupName": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "enum": ["dev", "staging", "production"] },
        "resourceNames": {
          "type": "object",
          "properties": {
            "keyVaultName": { "type": "string" },
            "storageAccountName": { "type": "string" },
            "logAnalyticsName": { "type": "string" },
            "applicationInsightsName": { "type": "string" },
            "appServicePlanName": { "type": "string" },
            "apiAppName": { "type": "string" },
            "portalAppName": { "type": "string" },
            "managedIdentityName": { "type": "string" }
          }
        }
      }
    },
    "sharePoint": {
      "type": "object",
      "required": ["siteUrl", "defaultDocumentLibrary"],
      "properties": {
        "siteUrl": { "type": "string", "format": "uri" },
        "siteId": { "type": "string" },
        "defaultDocumentLibrary": { "type": "string" },
        "permissionMode": {
          "type": "string",
          "enum": ["SitesSelected", "SitesReadAll", "Manual"]
        }
      }
    },
    "app": {
      "type": "object",
      "required": ["appName", "supportEmail"],
      "properties": {
        "appName": { "type": "string", "minLength": 1 },
        "customDomain": { "type": "string" },
        "runtimeBaseUrl": { "type": "string" },
        "apiBaseUrl": { "type": "string" },
        "supportEmail": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeArtifacts": {
      "type": "object",
      "$comment": "API and portal downloadUrl values must share the exact same approved parent host/path directory; this relational invariant is enforced by installer validators.",
      "additionalProperties": false,
      "required": ["contractVersion", "releaseId", "runtimeVersion", "sourceCommit", "api", "portal"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "releaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]{1,128}$"
        },
        "runtimeVersion": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "api": { "$ref": "#/$defs/runtimeArtifact" },
        "portal": { "$ref": "#/$defs/runtimeArtifact" }
      }
    },
    "entra": {
      "type": "object",
      "required": ["portalClientId", "apiClientId"],
      "properties": {
        "appRegistrationMode": {
          "type": "string",
          "enum": ["Create", "Reuse", "Manual"]
        },
        "portalClientId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "not": { "const": "00000000-0000-0000-0000-000000000000" }
        },
        "apiClientId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "not": { "const": "00000000-0000-0000-0000-000000000000" }
        },
        "permissionMode": {
          "type": "string",
          "enum": ["SitesSelected", "BroadGraphRead", "Manual"]
        },
        "requiredApplicationPermissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiredDelegatedScopes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "required": ["deploymentExportId"],
      "properties": {
        "baseUrl": { "type": "string" },
        "deploymentExportId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "exportedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "issuer": { "type": "string" },
        "issuerEnvironment": { "type": "string" },
        "onboardingSessionId": { "type": "string" },
        "discoveryId": { "type": "string" },
        "schemaId": { "type": "string" },
        "environmentId": { "type": "string" },
        "licenseActivationId": { "type": "string" },
        "entitlementSyncUrl": { "type": "string" },
        "publicKeyId": { "type": "string" },
        "packageHash": { "type": "string" },
        "packageHashAlgorithm": {
          "type": "string",
          "enum": ["SHA-256"]
        },
        "canonicalization": {
          "type": "string",
          "enum": ["json-c14n-v1"]
        },
        "signature": { "type": "string" },
        "signatureAlgorithm": { "type": "string" },
        "trustMode": {
          "type": "string",
          "enum": ["UnsignedAllowed", "SignedRequired"]
        },
        "jwksUrl": { "type": "string" },
        "revocationUrl": { "type": "string" },
        "correlationId": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["keyVaultName", "runtimeSecrets"],
      "properties": {
        "keyVaultName": { "type": "string", "minLength": 1 },
        "requiredSecretNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "promptForSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "label"],
            "properties": {
              "name": { "type": "string" },
              "label": { "type": "string" },
              "required": { "type": "boolean" },
              "generatedByInstaller": { "type": "boolean" }
            }
          }
        },
        "runtimeSecrets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keyVaultSecretName",
              "appSettingName",
              "label",
              "purpose",
              "source",
              "owner",
              "targetApp",
              "required",
              "minimumLength"
            ],
            "properties": {
              "keyVaultSecretName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,127}$"
              },
              "appSettingName": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "label": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "source": {
                "type": "string",
                "enum": ["operator", "installerGenerated"]
              },
              "owner": {
                "type": "string",
                "enum": ["customer"]
              },
              "targetApp": {
                "type": "string",
                "enum": ["api"]
              },
              "required": { "const": true },
              "minimumLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            }
          }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["values"] },
          { "required": ["connectionStrings"] },
          { "required": ["passwords"] },
          { "required": ["tokens"] },
          { "required": ["clientSecrets"] },
          { "required": ["apiKeys"] }
        ]
      }
    },
    "features": {
      "type": "object",
      "required": ["knowledgeBase", "customerPortal", "billingIntegration"],
      "properties": {
        "knowledgeBase": { "type": "boolean" },
        "customerPortal": { "type": "boolean" },
        "billingIntegration": { "type": "boolean" },
        "connectors": { "type": "boolean" },
        "orchestrator": { "type": "boolean" }
      }
    },
    "smokeTests": {
      "type": "object",
      "properties": {
        "apiHealthPath": { "type": "string" },
        "portalPath": { "type": "string" },
        "licenseValidationPath": { "type": "string" },
        "entitlementSyncPath": { "type": "string" }
      }
    }
  },
  "$defs": {
    "runtimeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "downloadUrl", "sha256", "startupCommand"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]+\\.zip$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "downloadUrl": { "type": "string", "format": "uri" },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "startupCommand": { "type": "string", "minLength": 1 }
      }
    }
  }
}
