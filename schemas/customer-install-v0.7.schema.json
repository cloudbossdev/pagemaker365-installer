{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pagemaker365.customer-install.0.7.schema.json",
  "title": "PageMaker365 customer-install package 0.7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "customer",
    "installation",
    "deployment",
    "controlPlane",
    "runtimeArtifacts",
    "protectedAcquisition",
    "runtimeConfiguration"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.7"
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customerId"
      ],
      "properties": {
        "customerId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "environmentId",
        "tenantId",
        "azureSubscriptionId"
      ],
      "properties": {
        "installationId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "environmentId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "azureSubscriptionId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentExportId"
      ],
      "properties": {
        "deploymentExportId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onboardingSessionId",
        "expiresAt",
        "acceptedInstallerCapability",
        "packageHash",
        "packageHashAlgorithm",
        "canonicalization",
        "signatureAlgorithm",
        "signingKeyId",
        "signature"
      ],
      "properties": {
        "onboardingSessionId": {
          "type": "string",
          "pattern": "^onb_[A-Za-z0-9_-]{16,96}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedInstallerCapability": {
          "const": "pagemaker365.customer-install.0.7.protected-acquisition.v1"
        },
        "packageHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packageHashAlgorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "json-c14n-v1"
        },
        "signatureAlgorithm": {
          "const": "Ed25519"
        },
        "signingKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "signature": {
          "type": "string",
          "minLength": 40,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "runtimeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestContractVersion",
        "manifestSha256",
        "product",
        "releaseId",
        "runtimeVersion",
        "sourceRepository",
        "sourceCommit",
        "provenanceSchemaVersion",
        "api",
        "portal"
      ],
      "properties": {
        "manifestContractVersion": {
          "const": "3.0"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "product": {
          "const": "PageMaker365"
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtimeVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
        },
        "sourceRepository": {
          "const": "cloudbossdev/spo-ui"
        },
        "sourceCommit": {
          "const": "c31427d0027adb4fd03de142fde18c4209ca44ce"
        },
        "provenanceSchemaVersion": {
          "const": "pagemaker365.runtime-provenance.v1"
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactKind",
            "fileName",
            "sizeBytes",
            "sha256",
            "startupCommand"
          ],
          "properties": {
            "artifactKind": {
              "enum": [
                "api",
                "portal"
              ]
            },
            "fileName": {
              "type": "string",
              "minLength": 5,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.zip$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "startupCommand": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "portal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactKind",
            "fileName",
            "sizeBytes",
            "sha256",
            "startupCommand"
          ],
          "properties": {
            "artifactKind": {
              "enum": [
                "api",
                "portal"
              ]
            },
            "fileName": {
              "type": "string",
              "minLength": 5,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.zip$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "startupCommand": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "protectedAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "sessionPath",
        "artifactPath",
        "receiptPath",
        "authorizationMode",
        "expiresAt",
        "artifactReferences"
      ],
      "properties": {
        "contractVersion": {
          "const": "pagemaker365.protected-acquisition.v1"
        },
        "sessionPath": {
          "const": "/api/onboarding/installer/runtime-delivery-sessions"
        },
        "artifactPath": {
          "const": "/api/onboarding/installer/runtime-artifacts/{artifactKind}"
        },
        "receiptPath": {
          "const": "/api/onboarding/installer/runtime-delivery-receipts"
        },
        "authorizationMode": {
          "const": "installer-session-v1"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "artifactReferences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api",
            "portal"
          ],
          "properties": {
            "api": {
              "type": "string",
              "pattern": "^ard_[A-Za-z0-9_-]{24,64}$"
            },
            "portal": {
              "type": "string",
              "pattern": "^ard_[A-Za-z0-9_-]{24,64}$"
            }
          }
        }
      }
    },
    "runtimeConfiguration": {
      "$ref": "pagemaker365.runtime-configuration-projection.v2.schema.json"
    }
  }
}
