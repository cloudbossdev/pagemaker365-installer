{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagemaker365.com/schemas/customer-install-v0.6.schema.json",
  "title": "PageMaker365 Private Customer Install Package 0.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "customer",
    "installation",
    "deployment",
    "controlPlane",
    "runtimeArtifacts",
    "protectedAcquisition",
    "runtimeConfiguration"
  ],
  "properties": {
    "contractVersion": { "const": "0.6" },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customerId"],
      "properties": { "customerId": { "$ref": "#/$defs/uuid" } }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationId", "environmentId", "tenantId"],
      "properties": {
        "installationId": { "$ref": "#/$defs/uuid" },
        "environmentId": { "$ref": "#/$defs/uuid" },
        "tenantId": { "$ref": "#/$defs/uuid" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentExportId"],
      "properties": { "deploymentExportId": { "$ref": "#/$defs/uuid" } }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onboardingSessionId",
        "expiresAt",
        "acceptedInstallerCapability",
        "packageHash",
        "packageHashAlgorithm",
        "canonicalization",
        "signatureAlgorithm",
        "signingKeyId",
        "signature"
      ],
      "properties": {
        "onboardingSessionId": { "type": "string", "pattern": "^onb_[A-Za-z0-9_-]{16,96}$" },
        "expiresAt": { "$ref": "#/$defs/canonicalUtc" },
        "acceptedInstallerCapability": { "const": "pagemaker365.customer-install.0.6.protected-acquisition.v1" },
        "packageHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "packageHashAlgorithm": { "const": "SHA-256" },
        "canonicalization": { "const": "json-c14n-v1" },
        "signatureAlgorithm": { "const": "Ed25519" },
        "signingKeyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "runtimeArtifacts": { "$ref": "#/$defs/runtimeArtifacts" },
    "protectedAcquisition": { "$ref": "#/$defs/protectedAcquisition" },
    "runtimeConfiguration": { "$ref": "#/$defs/runtimeConfiguration" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "canonicalUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "runtimeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "fileName", "sizeBytes", "sha256", "startupCommand"],
      "properties": {
        "artifactKind": { "enum": ["api", "portal"] },
        "fileName": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.zip$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "startupCommand": { "enum": ["node dist/index.js", "node .pm365/start-portal-runtime.mjs"] }
      }
    },
    "runtimeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestContractVersion",
        "manifestSha256",
        "product",
        "releaseId",
        "runtimeVersion",
        "sourceRepository",
        "sourceCommit",
        "provenanceSchemaVersion",
        "api",
        "portal"
      ],
      "properties": {
        "manifestContractVersion": { "const": "3.0" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "product": { "const": "PageMaker365" },
        "releaseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$" },
        "runtimeVersion": { "$ref": "#/$defs/runtimeVersion" },
        "sourceRepository": { "const": "cloudbossdev/spo-ui" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "provenanceSchemaVersion": { "const": "pagemaker365.runtime-provenance.v1" },
        "api": {
          "allOf": [
            { "$ref": "#/$defs/runtimeArtifact" },
            { "properties": { "artifactKind": { "const": "api" }, "startupCommand": { "const": "node dist/index.js" } } }
          ]
        },
        "portal": {
          "allOf": [
            { "$ref": "#/$defs/runtimeArtifact" },
            { "properties": { "artifactKind": { "const": "portal" }, "startupCommand": { "const": "node .pm365/start-portal-runtime.mjs" } } }
          ]
        }
      }
    },
    "protectedAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "sessionPath", "artifactPath", "receiptPath", "authorizationMode", "expiresAt", "artifactReferences"],
      "properties": {
        "contractVersion": { "const": "pagemaker365.protected-acquisition.v1" },
        "sessionPath": { "const": "/api/onboarding/installer/runtime-delivery-sessions" },
        "artifactPath": { "const": "/api/onboarding/installer/runtime-artifacts/{artifactKind}" },
        "receiptPath": { "const": "/api/onboarding/installer/runtime-delivery-receipts" },
        "authorizationMode": { "const": "installer-session-v1" },
        "expiresAt": { "$ref": "#/$defs/canonicalUtc" },
        "artifactReferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "portal"],
          "properties": {
            "api": { "type": "string", "pattern": "^ard_[A-Za-z0-9_-]{24,64}$" },
            "portal": { "type": "string", "pattern": "^ard_[A-Za-z0-9_-]{24,64}$" }
          }
        }
      }
    },
    "runtimeConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projectionSha256", "publicSettings"],
      "properties": {
        "schemaVersion": { "const": "pagemaker365.runtime-configuration-projection.v1" },
        "projectionSha256": { "$ref": "#/$defs/sha256" },
        "publicSettings": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["targetApp", "name", "value"],
            "properties": {
              "targetApp": { "enum": ["api", "portal"] },
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
              "value": {
                "oneOf": [
                  { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n]*$" },
                  { "type": "integer", "minimum": 0, "maximum": 2147483647 },
                  { "type": "boolean" }
                ]
              }
            }
          }
        }
      }
    }
  }
}
