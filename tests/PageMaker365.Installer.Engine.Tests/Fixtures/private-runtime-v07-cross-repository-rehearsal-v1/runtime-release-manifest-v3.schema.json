{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagemaker365.com/schemas/runtime-release-manifest-v3.schema.json",
  "title": "PageMaker365 Location-Free Runtime Release Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "product",
    "releaseId",
    "runtimeVersion",
    "sourceRepository",
    "sourceCommit",
    "provenanceSchemaVersion",
    "api",
    "portal"
  ],
  "properties": {
    "contractVersion": { "const": "3.0" },
    "product": { "const": "PageMaker365" },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "runtimeVersion": { "$ref": "#/$defs/runtimeVersion" },
    "sourceRepository": { "const": "cloudbossdev/spo-ui" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "provenanceSchemaVersion": { "const": "pagemaker365.runtime-provenance.v1" },
    "api": { "$ref": "#/$defs/apiArtifact" },
    "portal": { "$ref": "#/$defs/portalArtifact" }
  },
  "$defs": {
    "runtimeVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "artifactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256", "startupCommand", "artifactKind"],
      "properties": {
        "fileName": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.zip$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "startupCommand": { "type": "string" },
        "artifactKind": { "type": "string" }
      }
    },
    "apiArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactBase" },
        {
          "type": "object",
          "properties": {
            "startupCommand": { "const": "node dist/index.js" },
            "artifactKind": { "const": "api" }
          }
        }
      ]
    },
    "portalArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactBase" },
        {
          "type": "object",
          "properties": {
            "startupCommand": { "const": "node .pm365/start-portal-runtime.mjs" },
            "artifactKind": { "const": "portal" }
          }
        }
      ]
    }
  }
}
